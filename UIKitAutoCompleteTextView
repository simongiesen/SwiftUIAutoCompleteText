import SwiftUI
import UIKit

struct UIKitAutoCompleteTextView: UIViewRepresentable {
    @Binding var text: String
    let suggestions: [String]
    
    func makeUIView(context: Context) -> UITextView {
        let textView = UITextView()
        textView.delegate = context.coordinator
        textView.font = .systemFont(ofSize: 18)
        textView.backgroundColor = .clear  // Set background to clear
        textView.textColor = .black  // Default text color
        textView.autocorrectionType = .no
        textView.isScrollEnabled = false
        textView.borderStyle = .none
        return textView
    }
    
    func updateUIView(_ uiView: UITextView, context: Context) {
        uiView.text = text
    }
    
    func makeCoordinator() -> Coordinator {
        Coordinator(self)
    }
    
    class Coordinator: NSObject, UITextViewDelegate {
        var parent: AutoCompleteTextView
        
        init(_ parent: AutoCompleteTextView) {
            self.parent = parent
        }
        
        func textViewDidChange(_ textView: UITextView) {
            parent.text = textView.text
            showSuggestion(textView)
        }
        
        func showSuggestion(_ textView: UITextView) {
            let inputText = textView.text.lowercased()
            if let suggestion = parent.suggestions.first(where: { $0.lowercased().hasPrefix(inputText) }), inputText != suggestion.lowercased() {
                let attributedText = NSMutableAttributedString(string: suggestion)
                attributedText.addAttribute(.foregroundColor, value: UIColor.black, range: NSRange(location: 0, length: inputText.count))
                attributedText.addAttribute(.foregroundColor, value: UIColor.lightGray, range: NSRange(location: inputText.count, length: suggestion.count - inputText.count))
                
                textView.attributedText = attributedText
                textView.selectedRange = NSRange(location: inputText.count, length: 0) // Set cursor position
            }
        }
    }
}

struct ContentView: View {
    @State private var text = ""
    private let suggestions = ["Apple", "Banana", "Cherry", "Date", "Grape", "Mango", "Orange", "Peach", "Strawberry"]
    
    var body: some View {
        UIKitAutoCompleteTextView(text: $text, suggestions: suggestions)
            .frame(height: 50)
            .padding()
    }
}

